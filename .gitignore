# Gradle / Android build output
.gradle/
build/
local.properties
.kotlin/
captures/
*.hprof

# Env & secrets (never commit signing keys, service accounts, ad keys)
.env
.env.*
*.keystore
*.jks
google-services.json
service-account*.json

# Build artifacts: never let an APK or AAB into git history
*.apk
*.aab

# OS / editor
.DS_Store
*.swp
*.iml
.idea/
.vscode/

# Python bytecode (tools/, playbook scripts)
__pycache__/
*.pyc

# Raw captures of the reference app on the founder's phone (they show real callers)
docs/reference/raw/

# Emulator verification captures (regenerated by tools/verify_emulator.sh)
docs/verification/raw/
