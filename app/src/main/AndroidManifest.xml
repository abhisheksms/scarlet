<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- A call blocker is no use on a device that cannot receive calls. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />

    <!-- Asked for in context, when the user switches on something that notifies.
         Deliberately absent: contacts, call log, phone state, SMS. See ADR-002 and ADR-003. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- So the daily report check is still scheduled after the phone restarts. WorkManager
         asks for this itself, but the ads SDK's manifest strips it, so it is declared here. -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="replace" />

    <application
        android:name=".CallBlockApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CallBlock">

        <!-- adjustResize: the keyboard's height reaches Compose as an inset, so the field and
             its keys on Options can scroll above it while the ad slot stays where it is. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Google's sample app id until the founder supplies the live one. Set in app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- WorkManager initialises on demand (see CallBlockApp), so its start-up hook is removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Behind the "Allow For 1 Hour" action on a stopped-call notification. Not exported:
             only this app's own PendingIntent can reach it. -->
        <receiver
            android:name=".notify.AllowNumberReceiver"
            android:exported="false" />

        <!-- Exported so the system can bind to it; the permission means only the system can. -->
        <service
            android:name=".screening.ScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

    </application>

</manifest>
